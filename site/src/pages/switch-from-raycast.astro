---
import { getCollection } from 'astro:content';
import SwitchGuide from '../components/SwitchGuide.astro';
import { href } from '../lib/site';

const description = 'Move from Raycast to Stackbar in ten minutes: take over ⌘Space, import your snippets and quicklinks, and find the plugin for each Raycast command you use.';
const plugins = await getCollection('plugins');
/** A store plugin's page by its name, or the store when it isn't published. */
const plugin = (name: string) => {
  const found = plugins.find((p) => p.data.name === name);
  return { name, url: href(found ? `/plugins/${found.data.slug}/` : '/plugins/') };
};

const steps = [
  { title: 'Install Stackbar', html: 'Run <code>brew install --cask navbytes/tap/stackbar</code>, or use the <a href="' + href('/download/') + '">download page</a>. Applications, Calculator and File Search come installed.' },
  { title: 'Free up ⌘Space', html: 'In Raycast, open Settings › General and change or clear the Raycast hotkey. Then in Stackbar\'s Welcome window (or Settings › General) choose <b>Use ⌘Space</b>. If Spotlight still holds it, <b>Turn Off Spotlight\'s Shortcut…</b> takes you to the switch.' },
  { title: 'Export from Raycast', html: 'In Raycast, run <b>Export Snippets</b> and <b>Export Quicklinks</b>. Each saves a JSON file.' },
  { title: 'Import into Stackbar', html: 'Install Snippets and Quicklinks from the Store, then Settings › General › Coming from Raycast › <b>Snippets…</b> and <b>Quicklinks…</b> (or run <b>Import Snippets</b> in the palette). The template syntax is the same: <code>{clipboard}</code>, <code>{selection}</code>, <code>{date}</code>, <code>{argument}</code> and <code>{cursor}</code> keep working.' },
  { title: 'Bring your muscle memory', html: 'Settings › Commands gives any command an alias or a hotkey, like the ones you set in Raycast, including arrows and punctuation. Using a Hyper key? Turn on Caps Lock as Hyper in Settings, or keep yours in Karabiner-Elements (<a href="' + href('/docs/palette/') + '#a-hyper-key">how</a>). ⌘K, ⌘Return and ⌘1–9 work as you expect in the palette. <a href="' + href('/docs/permissions/') + '">Permissions</a> lists what macOS will ask for.' },
];

type Map = { from: string; stackbar: { name: string; url?: string }[]; note?: string };
const map: Map[] = [
  { from: 'Search apps and System Settings', stackbar: [plugin('Applications')], note: 'Installed' },
  { from: 'File Search', stackbar: [plugin('File Search')], note: 'Installed' },
  { from: 'Calculator, currency, time zones', stackbar: [plugin('Calculator')], note: 'Installed' },
  { from: 'Clipboard History', stackbar: [plugin('Clipboard History')] },
  { from: 'Snippets', stackbar: [plugin('Snippets')], note: 'Paste by name, or type a keyword like ;sig in any app' },
  { from: 'Quicklinks', stackbar: [plugin('Quicklinks')], note: 'Plus a library of ready-made searches' },
  { from: 'Window Management', stackbar: [plugin('Windows')] },
  { from: 'System commands (lock, sleep, empty Trash)', stackbar: [plugin('System Commands')] },
  { from: 'Search Emoji & Symbols', stackbar: [plugin('Emoji')] },
  { from: 'My Schedule, join meetings', stackbar: [plugin('Up Next')] },
  { from: 'Translate', stackbar: [plugin('Translate')] },
  { from: 'Switch apps and windows', stackbar: [plugin('App Switcher')] },
  { from: 'GitHub, Linear and Jira extensions', stackbar: [plugin('PR Cockpit'), plugin('Linear'), plugin('Jira')] },
  { from: 'Pomodoro and Caffeinate extensions', stackbar: [plugin('Pomodoro'), plugin('Stay Awake')] },
  { from: 'Raycast AI and Quick AI', stackbar: [plugin('Ask AI'), { name: 'Agents and MCP', url: href('/docs/agents/') }], note: 'Your own key or a local model; Tab hands what you typed to it' },
  { from: 'Writing an extension', stackbar: [{ name: 'Your first plugin', url: href('/docs/first-plugin/') }], note: 'One Swift file instead of a TypeScript project' },
];
---
<SwitchGuide
  from="Raycast"
  path="/switch-from-raycast/"
  description={description}
  headline="Bring your setup."
  highlight="Keep your keys."
  lede="About ten minutes: take over ⌘Space, import your snippets and quicklinks, and install the plugins for the commands you use."
  steps={steps}
  mapLede="Raycast's built-in commands, and the extensions people install most, with the Stackbar plugin for each."
  map={map}
/>
