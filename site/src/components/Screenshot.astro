---
// A real render of a plugin surface, made by `stackbarctl render --png` when
// the plugin was published. Rendered at 2x, shown at half size.
import { Image } from 'astro:assets';
interface Props { src?: string; alt: string; class?: string; eager?: boolean; }
const { src, alt, class: className, eager = false } = Astro.props;
---
{src
  ? <Image class:list={['shot', className]} src={src} alt={alt} inferSize widths={[360, 720]} sizes="360px" loading={eager ? 'eager' : 'lazy'} />
  : <div class:list={['shot', 'missing', className]} role="img" aria-label={alt}><slot /></div>}

<style>
  /* A render is the whole panel (360 points wide, window background), so it
     gets the rounded edge and shadow of a real menu-bar panel. */
  .shot { width: min(100%, 360px); height: auto; border-radius: 14px; box-shadow: 0 0 0 0.5px #00000040, 0 30px 60px -18px #00000080, 0 8px 18px -8px #00000040; }
  .missing { border-radius: 14px; background: var(--page-2); display: grid; place-items: center; min-height: 240px; color: var(--ink-2); font-size: var(--step--1); }
</style>
