---
// The hero: Stackbar's command palette answering a few queries in turn.
// Plain markup, so it reads without JavaScript; the script only types the
// queries and shows the matching result list. Reduced motion: the first
// state, still.
import Glyph from './Glyph.astro';

interface Props { label: string; }
const { label } = Astro.props;

type Row = { glyph: string; hue: string; title: string; detail?: string; kind: string; big?: boolean };
// `scope`: a plugin chip in the field (its name, then Tab). `preview`: the
// pane beside the list, as a check list.
type State = { query: string; scope?: string; sections: { title: string; rows: Row[] }[]; action: string; preview?: { title: string; items: { done: boolean; text: string }[] } };
const states: State[] = [
  {
    query: 'term',
    action: 'Open Application',
    sections: [
      { title: 'Applications', rows: [{ glyph: 'terminal', hue: 'graphite', title: 'Terminal', detail: '/System/Applications/Utilities', kind: 'Application' }] },
      { title: 'Files', rows: [{ glyph: 'file', hue: 'blue', title: 'terminal-setup.md', detail: '~/Documents/Notes', kind: 'File' }, { glyph: 'file', hue: 'blue', title: 'Terminal Themes', detail: '~/Downloads', kind: 'Folder' }] },
    ],
  },
  {
    query: '12 * 12 + 8',
    action: 'Copy Answer',
    sections: [
      { title: 'Calculator', rows: [{ glyph: 'equals', hue: 'orange', title: '152', detail: '12 × 12 + 8', kind: 'Copy', big: true }] },
    ],
  },
  {
    query: 'focus',
    action: 'Run Command',
    sections: [
      { title: 'Applications', rows: [{ glyph: 'window', hue: 'indigo', title: 'Focus', detail: 'System Settings', kind: 'Settings' }] },
      { title: 'Results', rows: [
        { glyph: 'timer', hue: 'red', title: 'Start a Focus Session', detail: 'Pomodoro', kind: 'Command' },
        { glyph: 'cup', hue: 'teal', title: 'Keep Awake For…', detail: 'Stay Awake', kind: 'Command' },
      ] },
    ],
  },
  {
    query: 'sig',
    action: 'Paste Snippet',
    sections: [
      { title: 'Results', rows: [
        { glyph: 'text', hue: 'pink', title: 'Signature', detail: 'Snippets', kind: 'Snippet' },
        { glyph: 'text', hue: 'pink', title: 'Sign-off for Reviews', detail: 'Snippets', kind: 'Snippet' },
      ] },
    ],
  },
  {
    query: 'launch',
    scope: 'Notes',
    action: 'Open Note',
    sections: [
      { title: 'Notes', rows: [
        { glyph: 'book', hue: 'amber', title: 'Launch checklist', detail: 'Edited today', kind: 'Note' },
        { glyph: 'book', hue: 'amber', title: 'Launch post draft', detail: 'Yesterday', kind: 'Note' },
      ] },
    ],
    preview: { title: 'Launch checklist', items: [
      { done: true, text: 'Notarize the build' },
      { done: true, text: 'Update the appcast' },
      { done: false, text: 'Post on the site' },
    ] },
  },
];
---
<figure class="scene" role="img" aria-label={label} data-palette-scene>
  <div class="key" aria-hidden="true"><kbd>⌘</kbd><kbd class="space">Space</kbd></div>
  <div class="panel" aria-hidden="true">
    <div class="field">
      <Glyph name="palette" />
      <span class="scope" data-scope hidden={!states[0].scope}>{states[0].scope}</span>
      <span class="typed" data-typed>{states[0].query}</span><span class="caret"></span>
    </div>
    {states.map((state, i) => (
      <div class:list={['results', { split: state.preview }]} data-state={i} data-query={state.query} data-scope={state.scope ?? ''} data-action={state.action} hidden={i !== 0}>
        <div class="list">
        {state.sections.map((section) => (
          <section>
            <h3>{section.title}</h3>
            {section.rows.map((row, r) => (
              <div class:list={['row', { selected: r === 0 && section === state.sections[0], big: row.big }]}>
                <span class="tile" style={`--h: var(--kit-${row.hue})`}><Glyph name={row.glyph} /></span>
                <span class="text"><b>{row.title}</b>{row.detail && <small>{row.detail}</small>}</span>
                <span class="kind">{row.kind}</span>
              </div>
            ))}
          </section>
        ))}
        </div>
        {state.preview && (
          <aside class="preview">
            <b>{state.preview.title}</b>
            <ul>{state.preview.items.map((item) => <li class:list={{ done: item.done }}><span class="box">{item.done ? '✓' : ''}</span>{item.text}</li>)}</ul>
          </aside>
        )}
      </div>
    ))}
    <div class="bar">
      <span class="brand"><img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/icon.svg`} alt="" width="18" height="18" /> Stackbar</span>
      <span class="act"><span data-action-label>{states[0].action}</span> <kbd>↩</kbd></span>
      <span class="act">Actions <kbd>⌘K</kbd></span>
    </div>
  </div>
</figure>

<script>
  function start() {
    const scene = document.querySelector<HTMLElement>('[data-palette-scene]');
    if (!scene || scene.dataset.running) return;
    scene.dataset.running = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const typed = scene.querySelector<HTMLElement>('[data-typed]')!;
    const action = scene.querySelector<HTMLElement>('[data-action-label]')!;
    const scope = scene.querySelector<HTMLElement>('[data-scope]')!;
    const states = [...scene.querySelectorAll<HTMLElement>('[data-state]')];
    let index = 0;
    let timer = 0;
    const wait = (ms: number) => new Promise<void>((done) => { timer = window.setTimeout(done, ms); });
    async function loop() {
      while (document.contains(scene)) {
        await wait(2600);
        index = (index + 1) % states.length;
        const next = states[index];
        const query = next.dataset.query!;
        // Clear, then type: results appear with the first letter, as the palette does.
        for (let n = typed.textContent!.length; n > 0; n--) { typed.textContent = typed.textContent!.slice(0, -1); await wait(28); }
        scope.hidden = true;
        // A scoped state: type the plugin's name, then Tab turns it into a chip.
        const name = next.dataset.scope!;
        if (name) {
          for (let n = 1; n <= name.length; n++) { typed.textContent = name.slice(0, n); await wait(70 + Math.random() * 60); }
          await wait(380);
          typed.textContent = '';
          scope.textContent = name;
          scope.hidden = false;
          await wait(320);
        }
        for (let n = 1; n <= query.length; n++) {
          typed.textContent = query.slice(0, n);
          if (n === 1) { states.forEach((s) => (s.hidden = s !== next)); action.textContent = next.dataset.action!; }
          await wait(70 + Math.random() * 60);
        }
      }
      clearTimeout(timer);
    }
    loop();
  }
  start();
  document.addEventListener('astro:page-load', start);
</script>

<style>
  .scene { position: relative; margin: 0; display: grid; justify-items: center; gap: 18px; }
  .key { display: flex; gap: 6px; }
  kbd { font: 600 12px/1 var(--font-text); padding: 6px 9px; border-radius: 7px; color: var(--stage-ink); background: #FFFFFF14; border: 1px solid #FFFFFF26; box-shadow: inset 0 -2px 0 #00000040; }
  .key kbd { font-size: 14px; padding: 9px 13px; }
  .key .space { min-width: 110px; text-align: center; }

  .panel {
    width: min(100%, 640px); border-radius: 22px; overflow: hidden; color: var(--stage-ink);
    background: linear-gradient(180deg, #2A2C3ECC, #181A28E6);
    border: 1px solid #FFFFFF2E; box-shadow: inset 0 1px 0 #FFFFFF1F, 0 40px 80px -30px #000000B3, 0 0 0 0.5px #00000080;
    backdrop-filter: blur(30px) saturate(160%); -webkit-backdrop-filter: blur(30px) saturate(160%);
  }
  .field { display: flex; align-items: center; gap: 12px; padding: 18px 20px; border-bottom: 1px solid #FFFFFF14; font: 400 clamp(18px, 1rem + 0.6vw, 22px)/1.2 var(--font-text); }
  .field :global(svg) { width: 22px; height: 22px; color: var(--stage-ink-2); flex: none; }
  .typed { white-space: pre; }
  .caret { width: 2px; height: 1.2em; margin-left: -10px; background: var(--brand-1-from); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .results { padding: 8px; min-height: 236px; }
  .results[hidden] { display: none; }
  .results.split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 8px; }
  .scope { padding: 4px 10px; border-radius: 8px; font-size: 0.75em; font-weight: 600; background: color-mix(in srgb, var(--kit-amber) 30%, transparent); }
  .scope[hidden] { display: none; }
  .preview { display: grid; align-content: start; gap: 12px; padding: 14px 16px; border-left: 1px solid #FFFFFF14; font-size: 14px; }
  .preview b { font: 600 16px/1.2 var(--font-display); }
  .preview ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .preview li { display: flex; align-items: center; gap: 9px; }
  .preview li.done { color: var(--stage-ink-2); text-decoration: line-through; }
  .box { display: grid; place-items: center; width: 16px; height: 16px; flex: none; border-radius: 5px; border: 1.5px solid var(--stage-ink-2); font-size: 11px; }
  .done .box { background: var(--kit-green); border-color: var(--kit-green); color: #fff; }
  section + section { margin-top: 4px; }
  h3 { margin: 0; padding: 8px 12px 6px; font: 600 11px/1 var(--font-text); letter-spacing: 0.02em; color: var(--stage-ink-2); }
  .row { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 8px 12px; border-radius: 11px; }
  .row.selected { background: #FFFFFF1A; }
  .tile { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; color: #fff; background: linear-gradient(160deg, color-mix(in srgb, var(--h) 85%, #fff), var(--h)); box-shadow: inset 0 1px 0 #FFFFFF40; }
  .tile :global(svg) { width: 18px; height: 18px; }
  .text { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .text b { font: 500 15px/1.3 var(--font-text); white-space: nowrap; }
  .text small { font-size: 13px; color: var(--stage-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .big .text { flex-direction: column; gap: 2px; }
  .big .text b { font: 600 34px/1.1 var(--font-display); letter-spacing: -0.02em; }
  .big { padding-block: 14px; }
  .kind { font-size: 12px; color: var(--stage-ink-2); }

  .bar { display: flex; align-items: center; gap: 18px; padding: 10px 16px; border-top: 1px solid #FFFFFF14; background: #00000026; font-size: 12px; color: var(--stage-ink-2); }
  .brand { display: flex; align-items: center; gap: 8px; margin-right: auto; font-weight: 600; color: var(--stage-ink); }
  .act { display: flex; align-items: center; gap: 7px; }
  .act kbd { padding: 4px 6px; font-size: 11px; }
  @media (max-width: 560px) {
    .text small, .kind, .bar .act:last-child { display: none; }
    .results { min-height: 200px; }
    .results.split { grid-template-columns: 1fr; }
    .preview { display: none; }
  }
</style>
