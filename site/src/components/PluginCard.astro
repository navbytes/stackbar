---
import PluginIcon from './PluginIcon.astro';
import { hueOf, type Plugin } from '../lib/plugins';
import { href } from '../lib/site';
interface Props { plugin: Plugin; }
const { plugin } = Astro.props;
const hue = hueOf(plugin);
---
<a class="card" href={href(`/plugins/${plugin.slug}/`)} style={`--hue: var(--kit-${hue}); --hue-soft: var(--kit-${hue}-soft)`}
   data-name={plugin.name.toLowerCase()} data-text={`${plugin.name} ${plugin.summary} ${plugin.category}`.toLowerCase()} data-category={plugin.category}>
  <span transition:name={`icon-${plugin.slug}`}><PluginIcon name={plugin.name} hue={hue} size={56} /></span>
  <span class="body">
    <span class="meta">{plugin.category}</span>
    <strong transition:name={`name-${plugin.slug}`}>{plugin.name}</strong>
    <span class="summary">{plugin.summary}</span>
  </span>
  <span class="get" aria-hidden="true">View</span>
</a>

<style>
  .card {
    position: relative; display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start;
    padding: 20px; border-radius: var(--radius-m); text-decoration: none;
    background: var(--card); border: 1px solid var(--line);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), border-color 0.3s;
  }
  .card::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0;
    background: radial-gradient(80% 100% at 0% 0%, var(--hue-soft), transparent 70%); transition: opacity 0.3s;
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); border-color: var(--line-2); }
  .card:hover::before { opacity: 1; }
  .body { position: relative; display: grid; gap: 4px; }
  .meta { font: 600 0.72rem/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--hue); }
  strong { font: 700 var(--step-1)/1.15 var(--font-display); letter-spacing: -0.02em; }
  .summary { color: var(--ink-2); font-size: var(--step--1); line-height: 1.5; }
  .get { position: absolute; top: 20px; right: 20px; padding: 6px 12px; border-radius: 999px; background: var(--hue-soft); color: var(--hue); font: 700 0.75rem/1 var(--font-text); opacity: 0; transform: translateX(-4px); transition: 0.25s var(--ease-out); }
  .card:hover .get, .card:focus-visible .get { opacity: 1; transform: none; }
</style>
