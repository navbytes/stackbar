---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** A design-system hue name that tints the page (focus rings, accents). */
  hue?: string;
  /** An absolute URL for link previews; the site's social card when left out. */
  image?: string;
  imageAlt?: string;
  /** schema.org objects, written as one JSON-LD script. */
  jsonLd?: object[];
  /** Keeps the page out of search results (the 404 page). */
  noindex?: boolean;
}
const { title, description, hue = 'violet', image, imageAlt, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Stackbar' ? 'Stackbar: live apps for your Mac menu bar, in one Swift file' : `${title} · Stackbar`;
const card = !image;
const shareImage = image ?? new URL(href('/og.png'), Astro.site).href;
const shareAlt = imageAlt ?? (card ? 'Stackbar: live apps for your Mac menu bar, in one Swift file' : title);
// `</` inside a string would end the script element early.
const ld = jsonLd.length === 0 ? '' : JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : { '@context': 'https://schema.org', '@graph': jsonLd.map(({ '@context': _, ...rest }: any) => rest) }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en" style={`--accent: var(--kit-${hue}); --accent-soft: var(--kit-${hue}-soft);`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={href('/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0A0B14" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stackbar" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={shareAlt} />
    {card && <meta property="og:image:width" content="1200" />}
    {card && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={card ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    {ld && <script type="application/ld+json" is:inline set:html={ld} />}
    <script is:inline>
      // Before first paint, so a chosen theme never flashes the other one.
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style>
  .skip { position: absolute; left: 16px; top: -48px; z-index: 100; padding: 8px 14px; border-radius: 8px; background: var(--card); color: var(--ink); }
  .skip:focus { top: 12px; }
</style>
